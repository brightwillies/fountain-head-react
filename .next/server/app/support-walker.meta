{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/support-walker/layout,_N_T_/support-walker/page,_N_T_/support-walker"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/support-walker/__PAGE__",
    "/support-walker",
    "/_index",
    "/_head"
  ]
}